# Required OneBot connection details
OB_HTTP_URL=http://snowluma:3000
OB_WS_URL=ws://snowluma:3001
ONEBOT_TOKEN=replace_with_your_onebot_token
OWNER_QQ=replace_with_owner_qq_number
SELF_ID=replace_with_bot_qq_number

# AI provider compatible with the OpenAI chat-completions API
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=replace_with_ai_provider_key
AI_MODEL=replace_with_model_name
AI_TEMPERATURE=0.7

# Local, container-managed message memory
SQLITE_PATH=/data/memory.sqlite3
IDENTITY_FILE=/data/identity.md
RECENT_MESSAGE_LIMIT=40
MAX_FILE_SIZE_MB=20

# Optional Ombre MCP memory integration. Keep disabled unless configured.
OMBRE_MCP_URL=
OMBRE_QQ_TOKEN=

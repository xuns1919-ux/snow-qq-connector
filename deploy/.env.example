# External SnowLuma runtime image. This repository does not distribute it.
SNOWLUMA_IMAGE=motricseven7/snowluma:latest

# Bind OneBot endpoints locally unless you intentionally expose them behind a proxy.
ONEBOT_HTTP_PORT=3000
ONEBOT_WS_PORT=3001
SNOWLUMA_WEBUI_PORT=5099

# Set a strong token in SnowLuma's own runtime configuration if its image supports it.
ONEBOT_TOKEN=replace_with_a_long_random_token
